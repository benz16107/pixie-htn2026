FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
OPENAI_API_KEY=
# Elastic serverless: the code authenticates with basic auth, so the username and password are
# the ones that matter. Without them everything falls back to the in-memory twin and says so.
ELASTIC_URL=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_KIBANA_URL=
# SENTRY_DSN_API must be the DSN of the project you actually own: read it back from
# GET /projects/{org}/{project}/keys/ rather than copying it by hand. A DSN whose project id is
# not in your org accepts every event and drops it.
SENTRY_DSN_API=
SENTRY_DSN_APP=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_ACCOUNT=
LINQ_API_KEY=
LINQ_FROM_NUMBER=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Which voice reads the case briefing. Unset means Harper, a documentary read.
ELEVENLABS_VOICE_ID=
BACKBOARD_API_KEY=
# dry composes every outbound action without sending; live really emails and really texts.
ATLAS_ACTIONS=
# The public tunnel (cloudflared). Linq posts webhooks here and the Sentry uptime check pings
# PUBLIC_URL/health, so both need updating when the tunnel restarts.
PUBLIC_URL=
BEN_PHONE=
# The phone app reads this at bundle time. Unset means the Expo app runs on its three cached
# fixtures and every Gemini feature is dead. Point it at PUBLIC_URL or the LAN address.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=
EXPO_TOKEN=
# A7 Composio: set once each toolkit is connected (`composio link <toolkit>`), never rely on the
# default-account routing. See docs/COMPOSIO.md.
COMPOSIO_GOOGLECALENDAR_ACCOUNT=
ATLAS_UNDERWRITER_EMAIL=
ATLAS_TZ=
COMPOSIO_GOOGLESHEETS_ACCOUNT=
COMPOSIO_SHEETS_ID=
COMPOSIO_LINEAR_ACCOUNT=
COMPOSIO_LINEAR_TEAM_ID=
COMPOSIO_NOTION_ACCOUNT=
COMPOSIO_NOTION_PARENT_ID=
